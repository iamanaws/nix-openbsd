Match the tests to OpenBSD's libc and kernel capabilities: named locales
do not supply regional formatting, quick_exit is absent, and RLIMIT_NPROC
does not limit threads. Keep unsupported features visible in lit results.

--- a/libcxx/utils/libcxx/test/features.py
+++ b/libcxx/utils/libcxx/test/features.py
@@ -444,7 +444,10 @@
     DEFAULT_FEATURES.append(
         Feature(
             name="locale.{}".format(locale),
-            when=lambda cfg, alts=alts: hasAnyLocale(cfg, alts),
+            # OpenBSD accepts these names but only implements C-locale formatting.
+            # A successful setlocale call does not mean the named locale exists.
+            when=lambda cfg, alts=alts: "__OpenBSD__" not in compilerMacros(cfg)
+            and hasAnyLocale(cfg, alts),
             actions=lambda cfg, locale=locale, alts=alts: _getLocaleFlagsAction(
                 cfg, locale, alts, provide_locale_conversions[locale]
             )
@@ -593,6 +596,15 @@
         when=lambda cfg: "__ANDROID__" in compilerMacros(cfg),
     ),
     Feature(name="netbsd", when=lambda cfg: "__NetBSD__" in compilerMacros(cfg)),
+    Feature(name="openbsd", when=lambda cfg: "__OpenBSD__" in compilerMacros(cfg)),
+    Feature(
+        name="has-quick-exit",
+        when=lambda cfg: sourceBuilds(cfg, """
+            #include <cstdlib>
+            void handler() {}
+            int main() { std::at_quick_exit(handler); std::quick_exit(0); }
+        """),
+    ),
     Feature(name="freebsd", when=lambda cfg: "__FreeBSD__" in compilerMacros(cfg)),
     Feature(
         name="LIBCXX-FREEBSD-FIXME",
--- a/libcxx/test/std/language.support/support.start.term/quick_exit.pass.cpp
