OpenBSD's sscanf accepts hexadecimal floats but returns zero.
Use strtof/strtod instead and require the whole token to be consumed.

--- a/include/toml11/types.hpp
+++ b/include/toml11/types.hpp
@@ -17,6 +17,7 @@
 
 #include <cstdint>
 #include <cstdio>
+#include <cstdlib>
 
 namespace toml
 {
@@ -160,7 +161,11 @@
 inline result<float, error_info>
 read_hex_float(const std::string& str, const source_location src, float val)
 {
-#if defined(_MSC_VER) && ! defined(__clang__)
+#if defined(__OpenBSD__)
+    char* end = nullptr;
+    val = std::strtof(str.c_str(), &end);
+    const auto res = end != str.c_str() && end == str.c_str() + str.size() ? 1 : 0;
+#elif defined(_MSC_VER) && ! defined(__clang__)
     const auto res = ::sscanf_s(str.c_str(), "%a", std::addressof(val));
 #else
     const auto res = std::sscanf(str.c_str(), "%a", std::addressof(val));
@@ -176,7 +181,11 @@
 inline result<double, error_info>
 read_hex_float(const std::string& str, const source_location src, double val)
 {
-#if defined(_MSC_VER) && ! defined(__clang__)
+#if defined(__OpenBSD__)
+    char* end = nullptr;
+    val = std::strtod(str.c_str(), &end);
+    const auto res = end != str.c_str() && end == str.c_str() + str.size() ? 1 : 0;
+#elif defined(_MSC_VER) && ! defined(__clang__)
     const auto res = ::sscanf_s(str.c_str(), "%la", std::addressof(val));
 #else
     const auto res = std::sscanf(str.c_str(), "%la", std::addressof(val));
--- a/tests/test_parse_floating.cpp
+++ b/tests/test_parse_floating.cpp
@@ -165,3 +165,20 @@
         CHECK_EQ(val.as_floating(), 343.5);
     }
 }
+
+#if defined(__OpenBSD__)
+TEST_CASE("OpenBSD hexadecimal float conversion")
+{
+    const auto src = toml::source_location(toml::detail::region{});
+    const auto single = toml::read_hex_float("0xABCp-3", src, float{});
+    const auto fractional = toml::read_hex_float("-0x1.8p+2", src, double{});
+    REQUIRE_UNARY(single.is_ok());
+    REQUIRE_UNARY(fractional.is_ok());
+    CHECK_EQ(single.unwrap(), 343.5f);
+    CHECK_EQ(fractional.unwrap(), -6.0);
+    CHECK_UNARY(toml::read_hex_float("0x1p0junk", src, float{}).is_err());
+    CHECK_UNARY(toml::read_hex_float("0x1p0junk", src, double{}).is_err());
+    CHECK_UNARY(toml::read_hex_float("", src, float{}).is_err());
+    CHECK_UNARY(toml::read_hex_float("", src, double{}).is_err());
+}
+#endif
