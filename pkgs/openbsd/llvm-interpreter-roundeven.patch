OpenBSD's libm lacks roundeven/roundevenf, so LLVM's interpreter aborts when
it tries to call them. Use LLVM's APFloat to round halfway values to the
nearest even integer without depending on those functions.

--- a/lib/ExecutionEngine/Interpreter/Execution.cpp
+++ b/lib/ExecutionEngine/Interpreter/Execution.cpp
@@ -11,6 +11,7 @@
 //===----------------------------------------------------------------------===//
 
 #include "Interpreter.h"
+#include "llvm/ADT/APFloat.h"
 #include "llvm/ADT/APInt.h"
 #include "llvm/ADT/Statistic.h"
 #include "llvm/CodeGen/IntrinsicLowering.h"
@@ -1098,6 +1099,24 @@
 
 void Interpreter::visitIntrinsicInst(IntrinsicInst &I) {
   ExecutionContext &SF = ECStack.back();
+
+  // C libraries need not provide roundeven, and nearbyint follows the host's
+  // rounding mode rather than the intrinsic's fixed ties-to-even mode.
+  if (I.getIntrinsicID() == Intrinsic::roundeven &&
+      (I.getType()->isFloatTy() || I.getType()->isDoubleTy())) {
+    GenericValue V = getOperandValue(I.getArgOperand(0), SF);
+    if (I.getType()->isFloatTy()) {
+      APFloat F(V.FloatVal);
+      F.roundToIntegral(APFloat::rmNearestTiesToEven);
+      V.FloatVal = F.convertToFloat();
+    } else {
+      APFloat F(V.DoubleVal);
+      F.roundToIntegral(APFloat::rmNearestTiesToEven);
+      V.DoubleVal = F.convertToDouble();
+    }
+    SetValue(&I, V, SF);
+    return;
+  }
 
   // If it is an unknown intrinsic function, use the intrinsic lowering
   // class to transform it into hopefully tasty LLVM code.
--- /dev/null
+++ b/test/ExecutionEngine/Interpreter/roundeven.ll
@@ -0,0 +1,111 @@
