@@ -991,6 +1007,37 @@
 
         sendException = false;
 
+#ifdef __OpenBSD__
+        /* Keep the slave open until the builder exits and its output drains.
+           OpenBSD can discard unread PTY output during process exit. This
+           supervisor and the builder retain the same build UID and process
+           group, so cancellation still terminates both. */
+        pid_t child = fork();
+        if (child == -1)
+            throw SysError("forking OpenBSD builder");
+        if (child != 0) {
+            int status;
+            while (waitpid(child, &status, 0) == -1)
+                if (errno != EINTR)
+                    throw SysError("waiting for OpenBSD builder");
+            while (tcdrain(STDERR_FILENO) == -1)
+                if (errno != EINTR)
+                    throw SysError("draining builder output");
+            if (WIFSIGNALED(status)) {
+                int sig = WTERMSIG(status);
+                signal(sig, SIG_DFL);
+                sigset_t signals;
+                sigemptyset(&signals);
+                sigaddset(&signals, sig);
+                sigprocmask(SIG_UNBLOCK, &signals, nullptr);
+                raise(sig);
+                _exit(128 + sig);
+            }
+            _exit(WEXITSTATUS(status));
+        }
+#endif
+
