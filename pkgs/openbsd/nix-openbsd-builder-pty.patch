+#ifdef __OpenBSD__
+        /* OpenBSD may discard unread PTY output on exit. Keep the slave open
+           until output drains; the supervisor shares the builder's UID and
+           process group. */
+        pid_t child = fork();
+        if (child == -1)
+            throw SysError("forking OpenBSD builder");
+        if (child != 0) {
+            int status;
+            while (waitpid(child, &status, 0) == -1)
+                if (errno != EINTR)
+                    throw SysError("waiting for OpenBSD builder");
+            while (tcdrain(STDERR_FILENO) == -1)
+                if (errno != EINTR)
+                    throw SysError("draining builder output");
+            if (WIFSIGNALED(status)) {
+                int sig = WTERMSIG(status);
+                signal(sig, SIG_DFL);
+                sigset_t signals;
+                sigemptyset(&signals);
+                sigaddset(&signals, sig);
+                sigprocmask(SIG_UNBLOCK, &signals, nullptr);
+                raise(sig);
+                _exit(128 + sig);
+            }
+            _exit(WEXITSTATUS(status));
+        }
+#endif
