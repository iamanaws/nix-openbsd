Close descriptors above a lowered resource limit before starting child processes.
Use the native descriptor-table operation instead of scanning to _SC_OPEN_MAX.

--- a/unix/file-descriptor.cc
+++ b/unix/file-descriptor.cc
@@ -108,6 +108,10 @@
     if (unix_close_range(MAX_KEPT_FD + 1, ~0U, 0) == 0) {
         return;
     }
+#elif defined(__OpenBSD__)
+    // Existing descriptors can exceed a lowered RLIMIT_NOFILE.
+    while (closefrom(MAX_KEPT_FD + 1) == -1 && errno == EINTR) { }
+    return;
 #endif

 #ifdef __linux__
