+#include <sys/types.h>
+#include <sys/sysctl.h>
+
+/* As in OpenBSD's ipcs(1), the sysctl records for semaphores and message
+   queues require the kernel-visible definitions. Keep these headers out
+   of the builder implementation and its other system headers. */
+#define _KERNEL
+#include <sys/ipc.h>
+#include <sys/sem.h>
+#include <sys/shm.h>
+#include <sys/msg.h>
+#undef _KERNEL
+
+extern "C" {
+int shmctl(int, int, struct shmid_ds *);
+int msgctl(int, int, struct msqid_ds *);
+int semctl(int, int, int, ...);
+}
+
+#include "sysv-ipc.hh"
+#include "nix/util/error.hh"
+#include <vector>
+#include <cstddef>
+#include <cerrno>
+
+namespace nix {
+
+/* Called with the build UID, after all its build processes have exited.
+   Kernel permission checks therefore also protect other users' objects
+   against IPC identifier reuse while taking the sysctl snapshot. */
+void cleanupOpenBSDSysVIPC(uid_t uid)
+{
+    auto read = [](int enabledName, int infoName, size_t padding) {
+        int enabled = 0;
+        size_t size = sizeof(enabled);
+        int enabledMib[] = {CTL_KERN, enabledName};
+        if (sysctl(enabledMib, 2, &enabled, &size, nullptr, 0) == -1)
+            throw SysError("checking OpenBSD System V IPC support");
+        std::vector<char> data;
+        if (!enabled)
+            return data;
+        int mib[] = {CTL_KERN, KERN_SYSVIPC_INFO, infoName};
+        if (sysctl(mib, 3, nullptr, &size, nullptr, 0) == -1)
+            throw SysError("querying OpenBSD System V IPC");
+        // The kernel's length omits alignment between the info header and
+        // the records. Supply zeroed tail padding, as the final record's
+        // unused trailing fields can otherwise extend past that length.
+        data.resize(size + padding);
+        if (sysctl(mib, 3, data.data(), &size, nullptr, 0) == -1)
+            throw SysError("reading OpenBSD System V IPC");
+        data.resize(size + padding);
+        return data;
+    };
+    auto check = [](int result) {
+        // Another process may already have removed the object. EPERM means
+        // the identifier now belongs to a different user; leave it alone.
+        if (result == -1 && errno != EINVAL && errno != EIDRM && errno != EPERM)
+            throw SysError("removing OpenBSD build IPC object");
+    };
+    auto id = [](unsigned int index, const struct ipc_perm & permission) {
+        return static_cast<int>((static_cast<unsigned int>(permission.seq) << 16) | (index & 0xffff));
+    };
+    auto owns = [uid](const struct ipc_perm & permission) {
+        return permission.uid == uid || permission.cuid == uid;
+    };
+    auto shm = read(KERN_SYSVSHM, KERN_SYSVIPC_SHM_INFO,
+        offsetof(struct shm_sysctl_info, shmids) - sizeof(struct shminfo));
+    if (!shm.empty()) {
+        auto info = reinterpret_cast<const struct shm_sysctl_info *>(shm.data());
+        if (shm.size() < offsetof(struct shm_sysctl_info, shmids)
+            || info->shminfo.shmmni < 0
+            || static_cast<size_t>(info->shminfo.shmmni)
+                > (shm.size() - offsetof(struct shm_sysctl_info, shmids)) / sizeof(struct shmid_ds))
+            throw Error("invalid OpenBSD shared-memory snapshot");
+        for (int i = 0; i < info->shminfo.shmmni; ++i) {
+            auto & entry = info->shmids[i];
+            if (entry.shm_cpid && owns(entry.shm_perm))
+                check(shmctl(id(i, entry.shm_perm), IPC_RMID, nullptr));
+        }
+    }
+    auto msg = read(KERN_SYSVMSG, KERN_SYSVIPC_MSG_INFO,
+        offsetof(struct msg_sysctl_info, msgids) - sizeof(struct msginfo));
+    if (!msg.empty()) {
+        auto info = reinterpret_cast<const struct msg_sysctl_info *>(msg.data());
+        if (msg.size() < offsetof(struct msg_sysctl_info, msgids)
+            || info->msginfo.msgmni < 0
+            || static_cast<size_t>(info->msginfo.msgmni)
+                > (msg.size() - offsetof(struct msg_sysctl_info, msgids)) / sizeof(struct msqid_ds))
+            throw Error("invalid OpenBSD message-queue snapshot");
+        for (int i = 0; i < info->msginfo.msgmni; ++i) {
+            auto & entry = info->msgids[i];
+            if (entry.msg_qbytes && owns(entry.msg_perm))
+                check(msgctl(id(i, entry.msg_perm), IPC_RMID, nullptr));
+        }
+    }
+    auto sem = read(KERN_SYSVSEM, KERN_SYSVIPC_SEM_INFO,
+        offsetof(struct sem_sysctl_info, semids) - sizeof(struct seminfo));
+    if (!sem.empty()) {
+        auto info = reinterpret_cast<const struct sem_sysctl_info *>(sem.data());
+        if (sem.size() < offsetof(struct sem_sysctl_info, semids)
+            || info->seminfo.semmni < 0
+            || static_cast<size_t>(info->seminfo.semmni)
+                > (sem.size() - offsetof(struct sem_sysctl_info, semids)) / sizeof(struct semid_ds))
+            throw Error("invalid OpenBSD semaphore snapshot");
+        for (int i = 0; i < info->seminfo.semmni; ++i) {
+            auto & entry = info->semids[i];
+            if (entry.sem_ctime && owns(entry.sem_perm))
+                check(semctl(id(i, entry.sem_perm), 0, IPC_RMID));
+        }
+    }
+}
