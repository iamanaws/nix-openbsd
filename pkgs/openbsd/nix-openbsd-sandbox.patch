+void ChrootOpenBSDDerivationBuilder::prepareSandbox()
+{
+    ChrootDerivationBuilder::prepareSandbox();
+    pathsInChroot.erase(tmpDirInSandbox());
+    for (auto & [path, entry] : pathsInChroot) {
+        if (!path.is_absolute() || path != path.lexically_normal() || path == "/"
+            || isDirOrInDir(path, tmpDirInSandbox()) || isDirOrInDir(tmpDirInSandbox(), path)
+            || isDirOrInDir(path, "/dev") || isDirOrInDir(store.storeDir, path))
+            throw Error("unsafe OpenBSD sandbox mapping '%s'", PathFmt(path));
+        if (!pathExists(entry.source)) {
+            if (entry.optional)
+                continue;
+            throw Error("required sandbox path '%s' does not exist", PathFmt(entry.source));
+        }
+        auto target = chrootRootDir / path.relative_path();
+        makeParents(target);
+        materialise(entry.source, target, isDirOrInDir(entry.source, store.config->realStoreDir.get()));
+    }
+    for (auto name : {"passwd", "group", "pwd.db", "spwd.db", "master.passwd"})
+        if (maybeLstat(chrootRootDir / "etc" / name))
+            throw Error("sandbox mapping overrides generated account file '%s'", name);
+    createPasswordDatabase();
+    writeFile(chrootRootDir / "etc/passwd",
+        fmt("nixbld:x:%u:%u:Nix build user:%s:/noshell\nnobody:x:32767:32767:Nobody:/var/empty:/noshell\n",
+            buildUser->getUID(), buildUser->getGID(), homeDir.native()));
+    writeFile(chrootRootDir / "etc/group", fmt("nixbld:x:%u:\nnobody:x:32767:\n", buildUser->getGID()));
+    if (!derivationType.isSandboxed()) {
+        for (auto name : {"resolv.conf", "hosts", "services"}) {
+            std::filesystem::path source = std::filesystem::path("/etc") / name;
+            auto target = chrootRootDir / "etc" / name;
+            if (pathExists(source) && !pathExists(target))
+                materialise(canonPath(source.native(), true), target, false);
+        }
+    }
+    createDirs(chrootRootDir / "dev");
+    for (auto name : {"null", "zero", "urandom"}) {
+        auto source = std::filesystem::path("/dev") / name;
+        auto st = lstat(source);
+        if (!S_ISCHR(st.st_mode))
+            throw Error("'%s' is not a character device", PathFmt(source));
+        auto target = chrootRootDir / source.relative_path();
+        if (mknod(target.c_str(), S_IFCHR | 0666, st.st_rdev) == -1)
+            throw SysError("creating sandbox device '%s'", PathFmt(target));
+        chmod(target, 0666);
+    }
+    createSymlink("urandom", chrootRootDir / "dev/random");
+    /* OpenBSD's fd pseudo-devices implement shell process substitution. */
+    if (pathExists("/dev/fd")) {
+        createDirs(chrootRootDir / "dev/fd");
+        for (auto & entry : DirectoryIterator("/dev/fd")) {
+            auto st = lstat(entry.path());
+            if (!S_ISCHR(st.st_mode))
+                continue;
+            auto target = chrootRootDir / "dev/fd" / entry.path().filename();
+            if (mknod(target.c_str(), S_IFCHR | 0666, st.st_rdev) == -1)
+                throw SysError("creating sandbox fd device");
+            chmod(target, 0666);
+        }
+        createSymlink("fd/0", chrootRootDir / "dev/stdin");
+        createSymlink("fd/1", chrootRootDir / "dev/stdout");
+        createSymlink("fd/2", chrootRootDir / "dev/stderr");
+    }
+    if (derivationType.isSandboxed())
+        prepareRoutingDomain();
+}
+
+void ChrootOpenBSDDerivationBuilder::startChild()
+{
+    processesStopped = false;
+    DerivationBuilderImpl::startChild();
+}
+
+void ChrootOpenBSDDerivationBuilder::enterChroot()
+{
+    if (routingDomain && setrtable(routingDomain) == -1)
+        throw SysError("entering sandbox routing domain %u", routingDomain);
+    if (chdir(chrootRootDir.c_str()) == -1 || chroot(".") == -1 || chdir("/") == -1)
+        throw SysError("entering OpenBSD build sandbox");
+}
+
+void ChrootOpenBSDDerivationBuilder::killSandbox(bool getStats)
+{
+    DerivationBuilderImpl::killSandbox(getStats);
+    if (!buildUser)
+        return;
+    /* killUser() only sends signals. A domain must not be removed until
+       its processes have exited: OpenBSD then moves its table to domain 0.
+       Zombies cannot execute or retain file/socket descriptors. */
+    for (unsigned int attempt = 0; attempt < 1000; ++attempt) {
+        int mib[] = {CTL_KERN, KERN_PROC, KERN_PROC_UID,
+            static_cast<int>(buildUser->getUID()), sizeof(struct kinfo_proc), 0};
+        size_t size = 0;
+        if (sysctl(mib, 6, nullptr, &size, nullptr, 0) == -1)
+            throw SysError("querying OpenBSD build processes");
+        std::vector<struct kinfo_proc> processes(size / sizeof(struct kinfo_proc) + 32);
+        mib[5] = static_cast<int>(processes.size());
+        size = processes.size() * sizeof(struct kinfo_proc);
+        if (sysctl(mib, 6, processes.data(), &size, nullptr, 0) == -1) {
+            if (errno == ENOMEM)
+                continue;
+            throw SysError("reading OpenBSD build processes");
+        }
+        bool live = false;
+        for (size_t i = 0; i < size / sizeof(struct kinfo_proc); ++i) {
+            auto & process = processes[i];
+            if (process.p_psflags & PS_ZOMBIE)
+                continue;
+            live = true;
+            break;
+        }
+        if (!live) {
+            processesStopped = true;
+            Pid cleanup = startProcess([&] {
+                if (setgroups(0, nullptr) == -1 || setgid(buildUser->getGID()) == -1
+                    || setuid(buildUser->getUID()) == -1)
+                    throw SysError("dropping privileges for OpenBSD IPC cleanup");
+                cleanupOpenBSDSysVIPC(buildUser->getUID());
+                _exit(0);
+            });
+            if (!statusOk(cleanup.wait()))
+                throw Error("OpenBSD build IPC cleanup failed");
+            return;
+        }
+        // Signal as the build UID. Signalling a PID from this snapshot as
+        // root could kill another user's process if the PID has been reused.
+        DerivationBuilderImpl::killSandbox(false);
+        usleep(10000);
+    }
+    throw Error("OpenBSD build processes did not exit; retaining their isolated routing domain");
+}
+
+void ChrootOpenBSDDerivationBuilder::cleanupBuild(bool force)
+{
+    if (routingDomain) {
+        if (!processesStopped)
+            killSandbox(false);
+        auto socket = networkSocket();
+        destroyDomain(socket.get(), routingDomain);
+        routingDomain = 0;
+        routingDomainLock.close();
+    }
+    /* Keep the usual --keep-failed directory, without retaining the copied
+       input closure or a live network domain. */
+    if (!force && settings.keepFailed && !drv.isBuiltin() && !tmpDir.empty() && pathExists(tmpDir)) {
+        auto kept = topTmpDir / "build";
+        moveFile(tmpDir, kept);
+        tmpDir = kept;
+    }
+    if (chrootRootDir.empty())
+        DerivationBuilderImpl::cleanupBuild(force);
+    else
+        ChrootDerivationBuilder::cleanupBuild(force);
+}
