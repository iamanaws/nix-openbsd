+void ChrootOpenBSDDerivationBuilder::anchor() {}
+
+void ChrootOpenBSDDerivationBuilder::prepareUser()
+{
+    if (geteuid() != 0 || !buildUser)
+        throw Error("OpenBSD sandboxing requires root and dedicated build users");
+    if (drvOptions.useUidRange(drv))
+        throw Error("uid-range is not supported by the OpenBSD sandbox");
+    if (drvOptions.getRequiredSystemFeatures(drv).count("recursive-nix"))
+        throw Error("recursive-nix is not supported by the OpenBSD sandbox");
+    for (auto & value : localSettings.sandboxRdomains.get()) {
+        auto id = string2Int<unsigned int>(value);
+        if (!id || *id == 0 || *id > RT_TABLEID_MAX || std::to_string(*id) != value)
+            throw Error("invalid sandbox-rdomains entry '%s': expected an integer from 1 to 255", value);
+    }
+    if (derivationType.isSandboxed() && localSettings.sandboxRdomains.get().empty())
+        throw Error("configure sandbox-rdomains for OpenBSD sandboxing");
+    DerivationBuilderImpl::prepareUser();
+}
+
+void ChrootOpenBSDDerivationBuilder::setBuildTmpDir()
+{
+    auto path = tmpDirInSandbox();
+    if (!path.is_absolute() || path != path.lexically_normal() || path == "/"
+        || isDirOrInDir(path, "/nix") || isDirOrInDir(path, "/dev")
+        || isDirOrInDir(path, "/etc") || isDirOrInDir(path, "/proc")
+        || isDirOrInDir(path, store.storeDir) || isDirOrInDir(store.storeDir, path))
+        throw Error("unsafe OpenBSD sandbox-build-dir '%s'", PathFmt(path));
+    /* No bind mounts on OpenBSD. Place the build tree inside the chroot
+       from the outset, keeping outputs on the store filesystem. */
+    createChroot();
+    tmpDir = chrootRootDir / path.relative_path();
+    createDirs(tmpDir);
+    chmod(tmpDir, 0700);
+}
+
+void ChrootOpenBSDDerivationBuilder::makeParents(const std::filesystem::path & target)
+{
+    auto current = chrootRootDir;
+    for (const auto & component : target.parent_path().lexically_relative(chrootRootDir)) {
+        if (component == ".")
+            continue;
+        if (component == "..")
+            throw Error("sandbox mapping escapes its root");
+        current /= component;
+        auto st = maybeLstat(current);
+        if (!st)
+            createDir(current, 0755);
+        else if (!S_ISDIR(st->st_mode))
+            throw Error("sandbox mapping parent '%s' is not a directory", PathFmt(current));
+    }
+}
+
+void ChrootOpenBSDDerivationBuilder::materialise(
+    const std::filesystem::path & source, const std::filesystem::path & target, bool immutable)
+{
+    checkInterrupt();
+    auto st = lstat(source);
+    auto existing = maybeLstat(target);
+    if (S_ISDIR(st.st_mode)) {
+        if (existing && !S_ISDIR(existing->st_mode))
+            throw Error("conflicting sandbox mapping at '%s'", PathFmt(target));
+        if (!existing)
+            createDir(target, 0700);
+        for (auto & entry : DirectoryIterator(source))
+            materialise(entry.path(), target / entry.path().filename(), immutable);
+        chmod(target, st.st_mode & 0555);
+        setWriteTime(target, st);
+    } else {
+        if (existing)
+            throw Error("conflicting sandbox mapping at '%s'", PathFmt(target));
+        if (S_ISLNK(st.st_mode)) {
+            createSymlink(readLink(source), target);
+            setWriteTime(target, st);
+        } else if (S_ISREG(st.st_mode)) {
+            /* Only immutable, root-owned store files may share inodes with
+               the host. Configured host paths are private snapshots. */
+            if (immutable && st.st_uid == 0 && !(st.st_mode & 0222)) {
+                if (link(source.c_str(), target.c_str()) == 0)
+                    return;
+                if (errno != EXDEV && errno != EMLINK && errno != EPERM)
+                    throw SysError("linking sandbox input '%s'", PathFmt(source));
+            }
+            AutoCloseFD input = open(source.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+            if (!input)
+                throw SysError("opening sandbox input '%s'", PathFmt(source));
+            AutoCloseFD output = open(target.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+            if (!output)
+                throw SysError("creating sandbox input '%s'", PathFmt(target));
+            char buffer[65536];
+            ssize_t count;
+            while ((count = ::read(input.get(), buffer, sizeof(buffer))) != 0) {
+                checkInterrupt();
+                if (count < 0) {
+                    if (errno == EINTR)
+                        continue;
+                    throw SysError("reading sandbox input '%s'", PathFmt(source));
+                }
+                writeFull(output.get(), std::string_view(buffer, count));
+            }
+            chmod(target, st.st_mode & 0555);
+            setWriteTime(target, st);
+        } else
+            throw Error("unsupported sandbox input type at '%s'", PathFmt(source));
+    }
+}
+
+AutoCloseFD ChrootOpenBSDDerivationBuilder::networkSocket()
+{
+    AutoCloseFD fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (!fd)
+        throw SysError("opening OpenBSD sandbox network socket");
+    return fd;
+}
+
+struct ifreq ChrootOpenBSDDerivationBuilder::interfaceRequest(unsigned int id)
+{
+    struct ifreq request = {};
+    auto name = fmt("lo%u", id);
+    strlcpy(request.ifr_name, name.c_str(), sizeof(request.ifr_name));
+    return request;
+}
+
+std::string ChrootOpenBSDDerivationBuilder::domainOwner()
+{
+    /* Include the state directory to distinguish independent Nix stores.
+       Hashing bounds the string to OpenBSD's interface description size. */
+    return fmt("nix-%s-uid-%u",
+        hashString(HashAlgorithm::SHA256, settings.nixStateDir.native())
+            .to_string(HashFormat::Base16, false).substr(0, 16),
+        buildUser->getUID());
+}
+
+void ChrootOpenBSDDerivationBuilder::destroyDomain(int socket, unsigned int id)
+{
+    auto request = interfaceRequest(id);
+    if (ioctl(socket, SIOCIFDESTROY, &request) == -1)
+        throw SysError("removing OpenBSD sandbox interface '%s'", request.ifr_name);
+}
+
+void ChrootOpenBSDDerivationBuilder::prepareRoutingDomain()
+{
+    auto socket = networkSocket();
+    auto lockDir = settings.nixStateDir / "sandbox-rdomains";
+    createDirs(lockDir);
+    auto owner = domainOwner();
+    for (auto & value : localSettings.sandboxRdomains.get()) {
+        auto id = string2Int<unsigned int>(value);
+        if (!id || *id == 0 || *id > RT_TABLEID_MAX)
+            throw Error("invalid sandbox-rdomains entry '%s': expected 1..255", value);
+        auto lock = openLockFile(lockDir / value, true);
+        if (!lockFile(lock.get(), ltWrite, false))
+            continue;
+        auto request = interfaceRequest(*id);
+        char description[IFDESCRSIZE] = {};
+        request.ifr_data = description;
+        if (ioctl(socket.get(), SIOCGIFDESCR, &request) == 0) {
+            /* Only recover our own UID's abandoned sandbox. Its user lock
+               is held and prepareUser() has already killed and waited for
+               its processes. Never adopt administrator-owned interfaces. */
+            if (owner != description)
+                continue;
+            destroyDomain(socket.get(), *id);
+        } else if (errno != ENXIO && errno != ENODEV)
+            throw SysError("checking sandbox routing domain %u", *id);
+
+        struct rt_tableinfo table = {};
+        size_t size = sizeof(table);
+        int mib[] = {CTL_NET, PF_ROUTE, 0, 0, NET_RT_TABLE, static_cast<int>(*id)};
+        if (sysctl(mib, 6, &table, &size, nullptr, 0) == 0) {
+            if (table.rti_domainid != 0)
+                continue;
+        } else if (errno != ENOENT && errno != ESRCH && errno != ENXIO)
+            throw SysError("checking routing table %u", *id);
+        request = interfaceRequest(*id);
+        if (ioctl(socket.get(), SIOCIFCREATE, &request) == -1) {
+            if (errno == EEXIST)
+                continue;
+            throw SysError("creating sandbox interface '%s'", request.ifr_name);
+        }
+        routingDomain = *id;
+        routingDomainLock = std::move(lock);
+        request.ifr_data = owner.data();
+        if (ioctl(socket.get(), SIOCSIFDESCR, &request) == -1)
+            throw SysError("marking sandbox routing domain %u", routingDomain);
+        request.ifr_rdomainid = routingDomain;
+        if (ioctl(socket.get(), SIOCSIFRDOMAIN, &request) == -1)
+            throw SysError("assigning sandbox routing domain %u", routingDomain);
+        if (ioctl(socket.get(), SIOCGIFRDOMAIN, &request) == -1 || request.ifr_rdomainid != static_cast<int>(routingDomain))
+            throw Error("sandbox loopback was not assigned to its private routing domain");
+
+        struct in_aliasreq ipv4 = {};
+        strlcpy(ipv4.ifra_name, request.ifr_name, sizeof(ipv4.ifra_name));
+        ipv4.ifra_addr.sin_len = sizeof(ipv4.ifra_addr);
+        ipv4.ifra_addr.sin_family = AF_INET;
+        ipv4.ifra_addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        ipv4.ifra_mask.sin_len = sizeof(ipv4.ifra_mask);
+        ipv4.ifra_mask.sin_family = AF_INET;
+        ipv4.ifra_mask.sin_addr.s_addr = htonl(0xff000000);
+        if (ioctl(socket.get(), SIOCAIFADDR, &ipv4) == -1)
+            throw SysError("configuring sandbox IPv4 loopback");
+
+        AutoCloseFD socket6 = ::socket(AF_INET6, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+        if (!socket6)
+            throw SysError("opening sandbox IPv6 socket");
+        struct in6_aliasreq ipv6 = {};
+        strlcpy(ipv6.ifra_name, request.ifr_name, sizeof(ipv6.ifra_name));
+        ipv6.ifra_addr.sin6_len = sizeof(ipv6.ifra_addr);
+        ipv6.ifra_addr.sin6_family = AF_INET6;
+        ipv6.ifra_addr.sin6_addr = in6addr_loopback;
+        ipv6.ifra_prefixmask.sin6_len = sizeof(ipv6.ifra_prefixmask);
+        ipv6.ifra_prefixmask.sin6_family = AF_INET6;
+        memset(&ipv6.ifra_prefixmask.sin6_addr, 0xff, sizeof(ipv6.ifra_prefixmask.sin6_addr));
+        ipv6.ifra_lifetime.ia6t_pltime = ND6_INFINITE_LIFETIME;
+        ipv6.ifra_lifetime.ia6t_vltime = ND6_INFINITE_LIFETIME;
+        if (ioctl(socket6.get(), SIOCAIFADDR_IN6, &ipv6) == -1)
+            throw SysError("configuring sandbox IPv6 loopback");
+        if (ioctl(socket.get(), SIOCGIFFLAGS, &request) == -1)
+            throw SysError("getting sandbox interface flags");
+        request.ifr_flags |= IFF_UP;
+        if (ioctl(socket.get(), SIOCSIFFLAGS, &request) == -1)
+            throw SysError("enabling sandbox loopback");
+        return;
+    }
+    throw Error("no reserved routing domain available; configure sandbox-rdomains for OpenBSD sandboxing");
+}
