+namespace nix {
+
+struct ChrootOpenBSDDerivationBuilder : ChrootDerivationBuilder
+{
+    ChrootOpenBSDDerivationBuilder(
+        LocalStore & store, std::shared_ptr<DerivationBuilderCallbacks> callbacks, DerivationBuilderParams params)
+        : DerivationBuilderImpl{store, callbacks, params}
+        , ChrootDerivationBuilder{store, callbacks, params}
+    {
+    }
+
+private:
+    void anchor() override;
+
+    AutoCloseFD routingDomainLock;
+    unsigned int routingDomain = 0;
+    bool processesStopped = false;
+
+    void prepareUser() override;
+    void setBuildTmpDir() override;
+    void makeParents(const std::filesystem::path & target);
+    void materialise(const std::filesystem::path & source, const std::filesystem::path & target, bool immutable);
+    static AutoCloseFD networkSocket();
+    static struct ifreq interfaceRequest(unsigned int id);
+    std::string domainOwner();
+    void destroyDomain(int socket, unsigned int id);
+    void prepareRoutingDomain();
+    void createPasswordDatabase();
+    void prepareSandbox() override;
+    void startChild() override;
+    void enterChroot() override;
+    void killSandbox(bool getStats) override;
+    void cleanupBuild(bool force) override;
+};
+
+} // namespace nix
