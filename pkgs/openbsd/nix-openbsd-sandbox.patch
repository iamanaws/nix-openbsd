+void ChrootOpenBSDDerivationBuilder::createPasswordDatabase()
+{
+    /* Like the FreeBSD backend, supply libc's database as well as the text
+       passwd file. This is OpenBSD pwd_mkdb's native record/key layout. */
+    auto closeDB = [](::DB * db) { if (db) (db->close)(db); };
+    std::unique_ptr<::DB, decltype(closeDB)> db(
+        dbopen((chrootRootDir / "etc/pwd.db").c_str(), O_CREAT | O_EXCL | O_RDWR, 0644, DB_HASH, nullptr), closeDB);
+    if (!db)
+        throw SysError("creating sandbox password database");
+    int number = 0;
+    auto addUser = [&](const std::string & name, uid_t uid, gid_t gid, const std::string & home) {
+        std::string record;
+        auto string = [&](const std::string & value) { record.append(value); record.push_back(0); };
+        auto scalar = [&](auto value) { record.append(reinterpret_cast<const char *>(&value), sizeof(value)); };
+        string(name);
+        string("*");
+        scalar(uid);
+        scalar(gid);
+        scalar(time_t{0});
+        string("");
+        string("Nix sandbox");
+        string(home);
+        string("/noshell");
+        scalar(time_t{0});
+        scalar(int{0});
+        auto put = [&](std::string key) {
+            DBT k = {key.data(), key.size()}, value = {record.data(), record.size()};
+            if ((db->put)(db.get(), &k, &value, R_NOOVERWRITE) != 0)
+                throw SysError("writing sandbox password database");
+        };
+        put(std::string(1, _PW_KEYBYNAME) + name);
+        put(std::string(1, _PW_KEYBYUID) + std::string(reinterpret_cast<const char *>(&uid), sizeof(uid)));
+        ++number;
+        put(std::string(1, _PW_KEYBYNUM) + std::string(reinterpret_cast<const char *>(&number), sizeof(number)));
+    };
+    addUser("nixbld", buildUser->getUID(), buildUser->getGID(), homeDir.native());
+    addUser("nobody", 32767, 32767, "/var/empty");
+    auto raw = db.release();
+    if ((raw->close)(raw) != 0)
+        throw SysError("closing sandbox password database");
+}
