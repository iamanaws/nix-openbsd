         psutil_oserror();
         return NULL;
     }
+    if (nswap == 0) {
+        return Py_BuildValue("(LLLII)", 0LL, 0LL, 0LL, 0U, 0U);
+    }
 
     if ((swdev = calloc(nswap, sizeof(*swdev))) == NULL) {
