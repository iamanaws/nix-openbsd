Follow-up to LLVM #200940 at e518ff87428816cab2bce45c9d1699a80959e1e4.
Header paths are relative to the module map's directory, which is already
libcxx/include/__cxx03. The repeated prefix prevents importing the module.
The LLVM libc configuration flag is 0/1; test its value too.

--- a/libcxx/include/__cxx03/__fwd/mbstate_t.h
+++ b/libcxx/include/__cxx03/__fwd/mbstate_t.h
@@ -31,7 +31,7 @@
 #  define __NEED_mbstate_t
 #  include <bits/alltypes.h>
 #  undef __NEED_mbstate_t
-#elif defined(_LIBCPP_LIBC_LLVM_LIBC)
+#elif _LIBCPP_LIBC_LLVM_LIBC
 #  include <llvm-libc-types/mbstate_t.h>
 #elif __has_include(<bits/types/mbstate_t.h>)
 #  include <bits/types/mbstate_t.h> // works on most Unixes

--- a/libcxx/include/__cxx03/module.modulemap
+++ b/libcxx/include/__cxx03/module.modulemap
@@ -591,7 +591,7 @@
   export *
 }
 module cxx03_std_private_fwd_mbstate_t     [system] {
-  header "__cxx03/__fwd/mbstate_t.h"
+  header "__fwd/mbstate_t.h"
   export *
 }
 module cxx03_std_private_node_handle       [system] {
